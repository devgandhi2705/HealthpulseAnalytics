# HealthPulse Analytics — Frontend Environment Variables
# Copy this file to .env and fill in the values.
# All variables must be prefixed with VITE_ to be available at build time.

# ---------------------------------------------------------------------------
# API base URL
# ---------------------------------------------------------------------------
#
# Development (frontend and backend on different ports):
#   VITE_API_BASE_URL=http://localhost:8000
#
# Production — same-origin deployment (Docker / Hugging Face Spaces):
#   Leave VITE_API_BASE_URL empty.  The frontend will call relative paths
#   such as /health and /articles, which hit the same host as the page.
#   VITE_API_BASE_URL=
#
# Production — separate backend domain:
#   VITE_API_BASE_URL=https://api.example.com
#
VITE_API_BASE_URL=http://localhost:8000
