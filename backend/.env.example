# HealthPulse Analytics — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default — no setup required):
#   Leave DATABASE_URL unset. The database file is created automatically at
#   backend/data/healthpulse.db on first startup.
#
# PostgreSQL (production):
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/healthpulse
DATABASE_URL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser requests.
# Default (development): http://localhost:3000,http://localhost:5173
# Production: set to your frontend domain, e.g. https://myapp.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend static files (production / single-server deployment)
# ---------------------------------------------------------------------------
# Absolute path to the Vite build output directory (frontend/dist).
# When set, FastAPI serves the React app as static files.
# Leave unset in development (frontend runs on its own dev server).
FRONTEND_DIST=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
